{
  "name": "@local/dsh-wallpaper",
  "version": "0.1.0",
  "private": true,
  "description": "Picture or live desktop wallpaper background for the Harness Web UI, with opacity control",
  "type": "module",
  "license": "MIT",
  "author": "phf0313",
  "homepage": "https://github.com/phf0313/dsh-wallpaper-auto#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phf0313/dsh-wallpaper-auto.git"
  },
  "bugs": {
    "url": "https://github.com/phf0313/dsh-wallpaper-auto/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "wallpaper",
    "background"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-layout"
      ],
      "immediately": true
    }
  }
}
